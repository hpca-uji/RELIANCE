{
  "name": "medical-imaging-viewer",
  "version": "1.0.0",
  "description": "A proxy to translate between dicomweb and dimse",
  "bin": "./build/app.js",
  "scripts": {
    "start": "ts-node src/app.ts",
    "format": "npx prettier ./src",
    "build": "tsc --p ./src/tsconfig.json",
    "pkg:win": "npm run build && npx pkg --targets node16-win-x64 package.json",
    "profile": "node -r ts-node/register --trace-gc --trace-warnings --prof --diagnostic-dir=./profiler/ src/app.ts",
    "session-certs": "mkdir -p src/certs/sessions && npx @fastify/secure-session > src/certs/sessions/session-key1 && npx @fastify/secure-session > src/certs/sessions/refresh-session-key1",
    "https-certs": "mkdir -p src/certs && openssl req -x509 -nodes -newkey rsa:2048 -keyout src/certs/server.key -out src/certs/server.crt -days 365 -subj \"/CN=localhost\""
  },
  "keywords": [
    "DICOMWEB",
    "PROXY",
    "DIMSE",
    "DICOM"
  ],
  "dependencies": {
    "@fastify/autoload": "^5.8.0",
    "@fastify/cookie": "^9.1.0",
    "@fastify/cors": "^8.4.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.2",
    "@fastify/mysql": "^4.2.0",
    "@fastify/secure-session": "^7.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^6.12.0",
    "@fastify/view": "^8.2.0",
    "@iwharris/dicom-data-dictionary": "^1.26.0",
    "@types/node": "^20.8.10",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "autocannon": "^7.12.0",
    "bcrypt": "^5.1.1",
    "config": "^3.3.9",
    "deepmerge": "^4.3.1",
    "dicom-parser": "^1.8.21",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "fastify": "^4.24.3",
    "fastify-https-redirect": "^1.0.4",
    "fastify-jwt": "^4.2.0",
    "fastify-plugin": "^4.5.1",
    "moment": "^2.29.4",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.3",
    "point-of-view": "^6.3.0",
    "prettier": "^3.0.3",
    "dicom-dimse-native": "^2.4.2",
    "shelljs": "^0.8.5",
    "simple-node-logger": "^21.8.12",
    "throat": "^6.0.2",
    "typescript": "^5.2.2",
    "why-is-node-running": "^2.2.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/config": "^3.3.2",
    "@types/ejs": "^3.1.4",
    "@types/eslint": "^8.44.6",
    "@types/eslint-config-prettier": "^6.11.2",
    "@types/eslint-plugin-prettier": "^3.1.2",
    "@types/shelljs": "^0.8.14",
    "eslint": "^8.52.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2"
  },
  "pkg": {
    "assets": [
      "./config/default.json",
      "./node_modules/dicom-dimse-native/build/Release/dcmtk.node"
    ]
  }
}